#!/usr/bin/env bash
# Creates a spread of containers covering every state the panel renders, so the
# UI can be exercised without waiting for real workloads to misbehave.
#
# Everything is tagged with the label below, and dev/clean removes exactly and
# only what carries it. Nothing here ever touches a container it did not create.
set -euo pipefail

LABEL="kaj.dev=1"
IMAGE="${KAJ_DEV_IMAGE:-busybox:latest}"

command -v docker >/dev/null || { echo "docker not found" >&2; exit 1; }
docker version --format '{{.Server.Version}}' >/dev/null 2>&1 \
  || { echo "docker daemon not reachable" >&2; exit 1; }

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "pulling $IMAGE"
  docker pull -q "$IMAGE"
fi

"$(dirname "$0")/clean" >/dev/null

# run <name> [extra docker args...] -- <command...>
run() {
  local name="$1"; shift
  docker run -d --label "$LABEL" --name "$name" "$@" >/dev/null
}

compose() {
  local project="$1" service="$2" name="$3"; shift 3
  docker run -d --label "$LABEL" \
    --label "com.docker.compose.project=$project" \
    --label "com.docker.compose.service=$service" \
    --name "$name" "$@" >/dev/null
}

echo "seeding..."

# A healthy multi-service project: the common case.
compose shop web       kaj-dev-shop-web    --no-healthcheck -p 18080:80 "$IMAGE" sleep 86400
compose shop api       kaj-dev-shop-api    --no-healthcheck "$IMAGE" sleep 86400
compose shop worker    kaj-dev-shop-worker --no-healthcheck "$IMAGE" sleep 86400

# A project in trouble: one healthy, one failing its healthcheck. Exercises the
# per-group severity rollup that turns a project header red.
compose blog db    kaj-dev-blog-db \
  --health-cmd 'true' --health-interval 5s --health-retries 1 "$IMAGE" sleep 86400
compose blog cache kaj-dev-blog-cache \
  --health-cmd 'false' --health-interval 3s --health-retries 1 "$IMAGE" sleep 86400

# Container metadata is written by whoever built the image, and Kaj treats it as
# untrusted. Docker restricts container *names* to [a-zA-Z0-9][a-zA-Z0-9_.-],
# so a hostile name is impossible — but labels are free-form, which makes the
# Compose project name the real place arbitrary text arrives. If any of this
# ever reaches a shell or a rich-text renderer, this row is where it shows.
compose '$(id > /tmp/kaj-pwned); rm -rf /' 'svc<img src=x onerror=alert(1)>' kaj-dev-hostile \
  --no-healthcheck "$IMAGE" sleep 86400

# A very long project and service name, for truncation and eliding.
compose 'a-very-long-compose-project-name-that-should-elide-rather-than-wrap' \
        'an-equally-long-service-name-for-good-measure' kaj-dev-long \
  --no-healthcheck "$IMAGE" sleep 86400

# Standalone containers, one per state the row can show.
run kaj-dev-solo     --no-healthcheck "$IMAGE" sleep 86400
run kaj-dev-crashed  --no-healthcheck "$IMAGE" sh -c 'exit 3'
run kaj-dev-paused   --no-healthcheck "$IMAGE" sleep 86400
run kaj-dev-starting \
  --health-cmd 'sleep 3600' --health-start-period 3600s --health-interval 5s \
  "$IMAGE" sleep 86400
# Restart-looping: also a useful stress test, since it emits events constantly.
run kaj-dev-looping  --no-healthcheck --restart always "$IMAGE" sh -c 'sleep 2; exit 1'

# Stopped cleanly. It has to exit 0 on its own: `docker stop` on a `sleep` ends
# in SIGKILL and exit 137, which the panel would rightly show as a problem —
# the opposite of what this row is here to prove.
run kaj-dev-stopped --no-healthcheck "$IMAGE" sh -c 'exit 0'
# Killed rather than stopped, so the two are visibly different.
run kaj-dev-killed  --no-healthcheck "$IMAGE" sleep 86400
docker kill kaj-dev-killed >/dev/null
# Created but never started.
docker create --label "$LABEL" --name kaj-dev-created --no-healthcheck "$IMAGE" sleep 86400 >/dev/null

docker pause kaj-dev-paused >/dev/null

echo
docker ps -a --filter "label=$LABEL" \
  --format 'table {{.Names}}\t{{.State}}\t{{.Status}}'
echo
echo "remove with: dev/clean"
